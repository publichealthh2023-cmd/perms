<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تقرير فحص تواريخ صلاحية المواد الغذائية | PHRMS</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--blue:#0759a6;--light:#eaf2f9;--line:#c7d5df;--ink:#243e55;--muted:#697e90;--ok:#187b43;--warn:#a56b00;--bad:#a52218}
*{box-sizing:border-box}body{margin:0;background:#edf3f7;font:14px/1.7 Arial,Tahoma,sans-serif;color:var(--ink)}
.toolbar{max-width:1100px;margin:20px auto 12px;padding:0 10px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.toolbar a,.toolbar button{border:0;border-radius:8px;cursor:pointer;padding:11px 17px;text-decoration:none;background:var(--blue);color:white;font:inherit;font-weight:bold}
.toolbar a{background:#e0eaf2;color:var(--blue)}.toolbar button:disabled{opacity:.5;cursor:not-allowed}
.message{max-width:1100px;margin:12px auto;padding:14px;background:#fff9e8;border-right:5px solid #cc8d00;border-radius:8px;white-space:pre-wrap}
.sheet{max-width:1100px;min-height:900px;margin:0 auto 20px;background:white;padding:28px 30px;box-shadow:0 4px 16px #2342}
.report-head{display:grid;grid-template-columns:140px 1fr 140px;direction:ltr;align-items:center;gap:12px;border-bottom:3px solid var(--blue);padding-bottom:15px}
.report-head img{max-height:90px;max-width:140px;object-fit:contain;display:block;margin:auto}
.report-head .center{direction:rtl;text-align:center}.report-head h1{margin:3px 0;font-size:23px;color:var(--blue)}.report-head h2{font-size:15px;margin:0;color:#517595}.report-head p{margin:0;font-size:12px;color:var(--muted)}
.report-title{background:#2e71aa;color:#fff;text-align:center;font-weight:bold;font-size:17px;margin:18px 0 12px;padding:10px}
.notice{padding:10px 13px;border:1px solid #dfbf86;border-radius:7px;background:#fff9eb;color:#905a00;margin:10px 0;font-size:13px;font-weight:bold}.notice.approved{background:#eaf7ef;color:var(--ok);border-color:#acd6b9}
.section-title{background:#edf4fa;color:#155581;font-size:15px;border-right:4px solid var(--blue);padding:8px 10px;margin:17px 0 8px}
table{width:100%;border-collapse:collapse;table-layout:auto}th,td{border:1px solid #aebfc9;padding:8px 7px;vertical-align:top;text-align:right;font-size:12px;white-space:normal;overflow-wrap:anywhere}th{background:#dceaf5;color:#194b72;font-weight:bold;text-align:center}.metadata td:nth-child(odd){background:#edf4fa;font-weight:bold;width:15%}.metadata td:nth-child(even){width:35%}.center{text-align:center}.mono{direction:ltr;unicode-bidi:isolate}
.status{padding:4px 8px;border-radius:12px;display:inline-block;white-space:nowrap;font-weight:bold;font-size:11px}.status.valid{color:#126633;background:#e5f6eb}.status.near{color:#956200;background:#fff3d8}.status.expired,.status.damaged{color:#a0251b;background:#ffebeb}.status.na{color:#596878;background:#edf0f4}.status.unverified{color:#596878;background:#edf0f4}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin:13px 0}.stat{border:1px solid var(--line);padding:9px;text-align:center;border-radius:7px}.stat strong{display:block;color:var(--blue);font-size:21px}.stat span{display:block;font-size:10px;color:var(--muted)}
.notes{border:1px solid #bbcbd8;padding:12px;white-space:pre-wrap;min-height:65px;font-size:12px}.signatures{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}.signature{border:1px solid #bdcbd6;min-height:150px;padding:12px;text-align:center}.signature b{display:block;background:#eaf2fa;color:#285b80;padding:6px;margin:-12px -12px 12px}.signature img{max-height:90px;max-width:250px;width:auto;object-fit:contain;display:block;margin:7px auto}.signature small{display:block;color:var(--muted)}
.footer{margin-top:24px;border-top:1px solid var(--line);padding-top:9px;text-align:center;color:var(--muted);font-size:10px}.muted{color:var(--muted)}.disabled{opacity:.55}.loading{padding:40px;text-align:center}
@media(max-width:650px){.sheet{margin:0 7px 20px;padding:12px 9px}.report-head{grid-template-columns:60px 1fr 60px;gap:5px}.report-head img{max-width:55px;max-height:50px}.report-head h1{font-size:16px}.report-head h2{font-size:11px}.stats{grid-template-columns:repeat(2,1fr)}th,td{font-size:10px;padding:5px 3px}.signatures{grid-template-columns:1fr}.table-wrap{overflow-x:auto}.data-table{min-width:690px}}
@page{size:A4 landscape;margin:10mm}
@media print{html,body{background:white!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}.toolbar,.message{display:none!important}.sheet{padding:0;margin:0;max-width:none;min-height:0;box-shadow:none}.table-wrap{overflow:visible}.data-table{min-width:0}tr,.signatures,.signature,.stats{break-inside:avoid;page-break-inside:avoid}thead{display:table-header-group}}
</style>
</head>
<body>
<div class="toolbar">
<a href="food-expiry-inbox.html">العودة إلى صندوق صلاحية الأغذية</a>
<a id="detailsLink" href="food-expiry-round.html">فتح تفاصيل الجولة</a>
<button id="printBtn" disabled onclick="window.print()">طباعة / حفظ PDF</button>
</div>
<div id="notice" class="message" role="status">جارٍ تحميل بيانات الجولة المحفوظة...</div>
<main id="sheet" class="sheet" hidden></main>
<script>
'use strict';
const SUPABASE_URL='https://xbivmhkqxmrkpjxfvemc.supabase.co';
const SUPABASE_KEY='sb_publishable_jTXNyxYwDMmJDUzg46rcdA_rySASiuE';
const db=window.supabase?window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY):null;
const LABELS={valid:'سليم',near:'قريب الانتهاء',expired:'منتهي الصلاحية',damaged:'تالف / غير سليم',na:'لا ينطبق',unverified:'لم يُفحص'};
const GROUPS=[['dry','المواد الجافة'],['dairy','الألبان ومشتقاتها والبيض'],['meat','اللحوم والدواجن والأسماك'],['produce','الخضروات والفواكه'],['canned','المعلبات والمشروبات والزيوت والتوابل'],['prepared','الأغذية المحضّرة والمخبوزات']];
const ACTIONS={none:'لم يحدد',monitor:'متابعة',isolate:'عزل المنتج',remove:'سحب المنتج',dispose:'إتلاف المنتج',return:'إرجاع المنتج',correct:'إجراء تصحيحي آخر',other:'إجراء آخر'};
const el=id=>document.getElementById(id);
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safeImage=x=>(typeof x==='string'&&/^data:image\/(?:png|jpe?g|webp);base64,[a-z0-9+/=]+$/i.test(x))?x:'';
function statusCell(s){let key=LABELS[s]?s:'unverified';return `<span class="status ${key}">${esc(LABELS[key])}</span>`}
function infoCell(label,value){return `<td>${esc(label)}</td><td>${esc(value||'—')}</td>`}
function message(s,bad=false){el('notice').textContent=s;el('notice').style.color=bad?'#a31d1d':'#6b4f1c'}
function normalizeItems(r){const list=Array.isArray(r.items)?r.items:[];if(r.schemaVersion==='checklist-v2'){
 return GROUPS.map(([key,label])=>{const found=list.find(x=>x.category===key||x.key===key||x.name===label);return found||{category:key,name:label,status:'unverified',note:'',findings:[]}})
}return list.map(x=>({...x,name:x.name||x.category||'صنف',status:x.status||'unverified'}))}
function normalizeFindings(r,items){let list=Array.isArray(r.findings)?r.findings:[];
 if(!list.length)list=items.flatMap(x=>Array.isArray(x.findings)?x.findings.map(f=>({...f,category:x.category,groupName:x.name})):[]);
 return list.filter(x=>x&&typeof x==='object')}
async function getEmployeeSignature(r){try{const {data,error}=await db.from('employees').select('signature_data').eq('employee_number',String(r.employeeNumber||'')).limit(1);if(error)throw error;return safeImage(data?.[0]?.signature_data)}catch(e){return ''}}
async function render(r){const items=normalizeItems(r),findings=normalizeFindings(r,items);const counts={valid:0,near:0,expired:0,damaged:0,na:0,unverified:0};items.forEach(x=>counts[x.status]!==undefined?counts[x.status]++:counts.unverified++);
 const total=counts.valid+counts.near+counts.expired+counts.damaged,compliance=total?Math.round((counts.valid+counts.near)*100/total):null;
 const approval=r.approval||{},approved=approval.status==='approved'&&Boolean(approval.approvedAt&&approval.approvedBy);
 const signature=await getEmployeeSignature(r),managerSig=approved?safeImage(approval.signature):'';
 const itemRows=items.map((x,i)=>{const status=x.status||'unverified';const note=x.note||(Array.isArray(x.findings)&&x.findings.length?x.findings.map(f=>[f.name,f.note].filter(Boolean).join(': ')).join(' | '):'');return `<tr><td class="center">${i+1}</td><td>${esc(x.name||x.category||'—')}</td><td class="center">${statusCell(status)}</td><td class="center">${esc(x.inspectedCount||'—')}</td><td>${esc(note||'لا توجد ملاحظات')}</td></tr>`}).join('');
 const findingRows=findings.map((x,i)=>`<tr><td class="center">${i+1}</td><td>${esc(GROUPS.find(p=>p[0]===x.category)?.[1]||x.groupName||x.category||'—')}</td><td>${esc(x.name||'—')}</td><td>${esc(x.quantity||'—')}</td><td>${esc(x.expiry||'—')}</td><td>${esc(x.note||'—')}</td><td>${esc(ACTIONS[x.action]||x.action||'—')}</td></tr>`).join('');
 el('sheet').innerHTML=`
 <header class="report-head"><img src="images/cluster-logo.png" alt="شعار التجمع"><div class="center"><h1>قسم الصحة العامة</h1><h2>Public Health Department</h2><p>مستشفى إرادة والصحة النفسية — PHRMS</p></div><img src="images/hospital-logo.png" alt="شعار المستشفى"></header>
 <div class="report-title">تقرير جولة التحقق من تواريخ صلاحية المواد الغذائية</div>
 <div class="notice ${approved?'approved':''}">${approved?'✓ تمت الموافقة على التقرير من مدير الصحة العامة':'تم حفظ الجولة مركزيًا — بانتظار مراجعة واعتماد مدير الصحة العامة'}</div>
 <h3 class="section-title">بيانات الجولة</h3><table class="metadata"><tbody>
 <tr>${infoCell('رقم الجولة',r.id)}${infoCell('رقم التكليف',r.taskId||'غير مجدولة')}</tr>
 <tr>${infoCell('الموظف المنفذ',r.employeeName)}${infoCell('الرقم الوظيفي',r.employeeNumber)}</tr>
 <tr>${infoCell('الموقع / القسم',r.locationName)}${infoCell('تاريخ الجولة',r.inspectionDate)}</tr>
 <tr>${infoCell('وقت الجولة',r.inspectionTime)}${infoCell('نوع الجولة',r.inspectionType||'دورية')}</tr>
 </tbody></table>
 <h3 class="section-title">ملخص نتائج الفحص</h3>
 <div class="stats"><div class="stat"><strong>${counts.valid}</strong><span>مجموعات سليمة</span></div><div class="stat"><strong>${counts.near}</strong><span>قريبة الانتهاء</span></div><div class="stat"><strong>${counts.expired+counts.damaged}</strong><span>منتهية / تالفة</span></div><div class="stat"><strong>${counts.na}</strong><span>لا ينطبق</span></div><div class="stat"><strong>${compliance===null?'—':compliance+'%'}</strong><span>نسبة السلامة</span></div></div>
 <h3 class="section-title">قائمة التحقق حسب مجموعات الأغذية</h3>
 <div class="table-wrap"><table class="data-table"><thead><tr><th style="width:4%">م</th><th style="width:26%">المجموعة الغذائية</th><th style="width:19%">نتيجة الفحص</th><th style="width:12%">عدد الأصناف</th><th>الملاحظات</th></tr></thead><tbody>${itemRows||'<tr><td colspan="5">لا توجد تفاصيل محفوظة للمجموعات الغذائية.</td></tr>'}</tbody></table></div>
 ${findingRows?`<h3 class="section-title">تفاصيل المنتجات التي تتطلب إجراء</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>م</th><th>المجموعة</th><th>المنتج</th><th>الكمية</th><th>الانتهاء</th><th>الملاحظات</th><th>الإجراء التصحيحي</th></tr></thead><tbody>${findingRows}</tbody></table></div>`:''}
 <h3 class="section-title">الملاحظات العامة والمتابعة</h3><div class="notes">${esc(r.notes||'لا توجد ملاحظات عامة.')}
الجهة المسؤولة: ${esc(r.actionOwner||'غير محددة')} — تاريخ المتابعة: ${esc(r.followupDate||'—')}</div>
 <h3 class="section-title">التوقيعات والاعتماد</h3><div class="signatures">
 <div class="signature"><b>منفذ الجولة</b><div>${esc(r.employeeName||'—')}</div><small>الرقم الوظيفي: ${esc(r.employeeNumber||'—')}</small>${signature?`<img src="${signature}" alt="توقيع الموظف">`:'<small>توقيع الموظف غير متوفر</small>'}</div>
 <div class="signature"><b>اعتماد مدير إدارة الصحة العامة</b><div>${esc(approved?approval.managerName:'بانتظار الاعتماد')}</div>${managerSig?`<img src="${managerSig}" alt="توقيع المدير"><small>تاريخ الاعتماد: ${esc(approval.approvedAt||'')}</small>`:'<small>لا يظهر توقيع المدير إلا بعد اعتماد الجولة في صندوق التقارير.</small>'}</div>
 </div>
 <footer class="footer">نظام إدارة جولات الصحة العامة PHRMS — تقرير مستخرج من الجولة المحفوظة مركزيًا.</footer>`;
 el('sheet').hidden=false;el('printBtn').disabled=false;el('notice').hidden=true;
}
async function init(){if(!db){message('تعذر تحميل خدمة Supabase.',true);return}const params=new URLSearchParams(location.search),id=params.get('id')||params.get('view')||params.get('roundId');if(!id){message('لا يوجد رقم جولة في الرابط. افتح الجولة من صندوق تقارير الصلاحية.',true);return}
 el('detailsLink').href='food-expiry-round.html?view='+encodeURIComponent(id);
 try{const auth=await db.auth.getUser();if(auth.error||!auth.data?.user){message('يلزم تسجيل الدخول بالحساب الإداري أولًا ثم فتح التقرير من صندوق الصلاحية.',true);return}
 const {data,error}=await db.from('inspection_records').select('round_id,round_type,record_data').eq('round_type','foodExpiry').eq('round_id',id).limit(1).maybeSingle();if(error)throw error;if(!data){message('لم يتم العثور على الجولة المطلوبة في النظام المركزي.',true);return}
 const r=data.record_data;if(!r||r.roundType!=='foodExpiry'){message('نوع التقرير غير مطابق لجولات صلاحية الأغذية.',true);return}await render(r)
 }catch(e){message('تعذر تحميل تفاصيل التقرير: '+(e?.message||String(e)),true)}}
window.addEventListener('DOMContentLoaded',init);
</script>
</body>
</html>